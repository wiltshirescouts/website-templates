# Copy to .dev.vars (Cloudflare Workers) or your host's secret store. Never commit real values.

# Microsoft Entra ID app registration (single tenant)
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=replace-me

# At least 32 random characters, used to sign the sign-in state and session cookies
SESSION_SECRET=replace-with-a-long-random-string-of-32-chars-or-more

# Brevo transactional email (server side only)
BREVO_API_KEY=replace-me
