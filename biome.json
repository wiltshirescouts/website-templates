{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": {
    "includes": [
      "src/**",
      "test/**",
      "playground/src/**",
      "e2e/**",
      "*.ts",
      "*.json",
      "!design",
      "!**/node_modules"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "linter": { "enabled": true, "rules": { "preset": "recommended", "a11y": { "preset": "none" } } },
  "css": { "parser": { "tailwindDirectives": true } }
}
